{
  "name": "tapvern",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem absensi sekolah terintegrasi IoT dan Real-time Dashboard",
  "author": "usagi <usagi@example.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.tapvern.app",
    "productName": "Tapvern",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["deb", "AppImage"],
      "icon": "src/app/icon.png",
      "category": "Education",
      "maintainer": "usagi <usagi@example.com>",
      "executableName": "tapvern"
    },
    "win": {
      "target": ["nsis"],
      "icon": "src/app/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "src/app/icon.png"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}